# ============================================================
# ENVIRONMENT VARIABLE TEMPLATE
# This file IS committed to git — it shows which variables
# are required. Never put real secrets here.
#
# To set up locally:
#   cp .env.example .env.local
#   fill in the values in .env.local
# ============================================================

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                  # Public URL of the app (e.g. https://einhorn.com)

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=                          # Full connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net)
MONGODB_DB_NAME=                      # Database name (e.g. einhorn)
